#!/bin/sh
set -eu
if [ "${3:-/}" != / ]; then
    echo 'Install BabelAudio only on the active system volume.' >&2
    exit 1
fi
babel_driver='/Library/Audio/Plug-Ins/HAL/BabelAudio.driver'
for babel_path in /Library /Library/Audio /Library/Audio/Plug-Ins /Library/Audio/Plug-Ins/HAL "$babel_driver"; do
    if [ -L "$babel_path" ]; then
        echo "Refusing to replace a symbolic link: $babel_path" >&2
        exit 1
    fi
done
if [ -e "$babel_driver" ]; then
    if [ ! -d "$babel_driver" ] || [ -L "$babel_driver/Contents" ] || [ -L "$babel_driver/Contents/Info.plist" ]; then
        echo 'Unexpected existing driver layout; installation stopped.' >&2
        exit 1
    fi
    babel_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$babel_driver/Contents/Info.plist")
    if [ "$babel_id" != 'org.babel.audio.driver' ]; then
        echo 'The existing bundle does not belong to Babel; installation stopped.' >&2
        exit 1
    fi
fi
exit 0
