; Babel WaveRT adapter. Derived from Microsoft SimpleAudioSample; MS-PL.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=09/30/2026,1.0.0.0
CatalogFile=BabelAudio.cat
PnpLockdown=1

[Manufacturer]
%ProviderName%=Babel,NT$ARCH$.10.0...19041
[Babel.NT$ARCH$.10.0...19041]
%Babel.DeviceDesc%=BabelAudio,ROOT\BabelAudio

[SourceDisksNames]
1=%Babel.Disk%
[SourceDisksFiles]
BabelAudio.sys=1
[DestinationDirs]
Babel.Copy=13
[Babel.Copy]
BabelAudio.sys

[BabelAudio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Babel.Copy
AddReg=Babel.Adapter
[Babel.Adapter]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,BabelAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Babel.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Babel.DeviceDesc%

[BabelAudio.NT.Services]
AddService=BabelAudio,0x00000002,Babel.Service
[Babel.Service]
DisplayName=%Babel.DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\BabelAudio.sys
[BabelAudio.NT.Wdf]
KmdfService=BabelAudio,Babel.Wdf
[Babel.Wdf]
KmdfLibraryVersion=$KMDFVERSION$
[BabelAudio.NT.HW]
AddReg=Babel.Hardware
[Babel.Hardware]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[BabelAudio.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,"WaveBabelMicRender",Babel.WaveBabelMicRender
AddInterface=%KSCATEGORY_RENDER%,"WaveBabelMicRender",Babel.WaveBabelMicRender
AddInterface=%KSCATEGORY_REALTIME%,"WaveBabelMicRender",Babel.WaveBabelMicRender
AddInterface=%KSCATEGORY_AUDIO%,"TopologyBabelMicRender",Babel.TopologyBabelMicRender
AddInterface=%KSCATEGORY_TOPOLOGY%,"TopologyBabelMicRender",Babel.TopologyBabelMicRender
AddInterface=%KSCATEGORY_AUDIO%,"WaveBabelMicCapture",Babel.WaveBabelMicCapture
AddInterface=%KSCATEGORY_CAPTURE%,"WaveBabelMicCapture",Babel.WaveBabelMicCapture
AddInterface=%KSCATEGORY_REALTIME%,"WaveBabelMicCapture",Babel.WaveBabelMicCapture
AddInterface=%KSCATEGORY_AUDIO%,"TopologyBabelMicCapture",Babel.TopologyBabelMicCapture
AddInterface=%KSCATEGORY_TOPOLOGY%,"TopologyBabelMicCapture",Babel.TopologyBabelMicCapture
AddInterface=%KSCATEGORY_AUDIO%,"WaveBabelSpeakerRender",Babel.WaveBabelSpeakerRender
AddInterface=%KSCATEGORY_RENDER%,"WaveBabelSpeakerRender",Babel.WaveBabelSpeakerRender
AddInterface=%KSCATEGORY_REALTIME%,"WaveBabelSpeakerRender",Babel.WaveBabelSpeakerRender
AddInterface=%KSCATEGORY_AUDIO%,"TopologyBabelSpeakerRender",Babel.TopologyBabelSpeakerRender
AddInterface=%KSCATEGORY_TOPOLOGY%,"TopologyBabelSpeakerRender",Babel.TopologyBabelSpeakerRender
AddInterface=%KSCATEGORY_AUDIO%,"WaveBabelSpeakerCapture",Babel.WaveBabelSpeakerCapture
AddInterface=%KSCATEGORY_CAPTURE%,"WaveBabelSpeakerCapture",Babel.WaveBabelSpeakerCapture
AddInterface=%KSCATEGORY_REALTIME%,"WaveBabelSpeakerCapture",Babel.WaveBabelSpeakerCapture
AddInterface=%KSCATEGORY_AUDIO%,"TopologyBabelSpeakerCapture",Babel.TopologyBabelSpeakerCapture
AddInterface=%KSCATEGORY_TOPOLOGY%,"TopologyBabelSpeakerCapture",Babel.TopologyBabelSpeakerCapture

[Babel.WaveBabelMicRender]
AddReg=Babel.WaveBabelMicRender.Properties
[Babel.WaveBabelMicRender.Properties]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,"Babel Audio v1"

[Babel.TopologyBabelMicRender]
AddReg=Babel.TopologyBabelMicRender.Properties
[Babel.TopologyBabelMicRender.Properties]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,"Babel Audio v1"
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x10001,1
HKR,EP\0,%PKEY_Device_DeviceDesc%,,"Babel Microphone Feed"
HKR,EP\0,%PKEY_Device_FriendlyName%,,"Babel Microphone Feed"
HKR,EP\0,%PKEY_DeviceInterface_FriendlyName%,,"Babel Audio v1"
HKR,EP\0,%PKEY_Babel_Role%,,"babel:mic:render:v1"
HKR,EP\0,%PKEY_Babel_Driver%,,"org.babel.audio.driver.v1"

