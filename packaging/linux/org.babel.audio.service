# Babel-Autostart-Owner: org.babel.audio.autostart.v1
[Unit]
Description=Babel audio tray and local dashboard
PartOf=graphical-session.target
After=graphical-session-pre.target
ConditionUser=!root
ConditionEnvironment=|DISPLAY
ConditionEnvironment=|WAYLAND_DISPLAY
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/babel-launch
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=graphical-session.target
